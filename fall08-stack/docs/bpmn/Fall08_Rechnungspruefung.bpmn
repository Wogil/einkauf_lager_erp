<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Fall08" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fall08-Generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Fall08" name="Fall 08 – Eingangsrechnungen prüfen und zur Freigabe vorbereiten">
<bpmn:participant id="P_Lief" name="Lieferant" />
<bpmn:participant id="P_SB" name="Kreditorenbuchhaltung (Sachbearbeitung Voßkamp)" processRef="Process_P_SB" />
<bpmn:participant id="P_Sys" name="Rechnungseingangsprüfung (Lösung Fall 08)" processRef="Process_P_Sys" />
<bpmn:messageFlow id="Msg_P_Lief_s_start" name="Rechnung (Mail mit PDF / XML)" sourceRef="P_Lief" targetRef="s_start" />
<bpmn:messageFlow id="Msg_t_mail_sb_start" name="Vorschlag mit Begründung" sourceRef="t_mail" targetRef="sb_start" />
<bpmn:messageFlow id="Msg_sb_end_t_recv" name="Entscheidung" sourceRef="sb_end" targetRef="t_recv" />
</bpmn:collaboration>
<bpmn:process id="Process_P_SB" isExecutable="false">
<bpmn:startEvent id="sb_start" name="Vorschlag erhalten"><bpmn:outgoing>Flow_sb_start_sb_task</bpmn:outgoing><bpmn:messageEventDefinition id="MED_sb_start" /></bpmn:startEvent>
<bpmn:userTask id="sb_task" name="Vorschlag prüfen und entscheiden"><bpmn:incoming>Flow_sb_start_sb_task</bpmn:incoming><bpmn:outgoing>Flow_sb_task_sb_end</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="sb_end" name="Entscheidung per Link"><bpmn:incoming>Flow_sb_task_sb_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_sb_end" /></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_sb_start_sb_task" sourceRef="sb_start" targetRef="sb_task" />
<bpmn:sequenceFlow id="Flow_sb_task_sb_end" sourceRef="sb_task" targetRef="sb_end" />
<bpmn:textAnnotation id="an_sb"><bpmn:text>freigeben · klären · ablehnen · Vorschlag falsch (mit Kommentar). Freigabestufe nach Betrag laut Konfiguration</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_an_sb" sourceRef="sb_end" targetRef="an_sb" />
</bpmn:process>
<bpmn:process id="Process_P_Sys" isExecutable="false">
<bpmn:laneSet id="LaneSet_P_Sys">
<bpmn:lane id="L_n8n" name="n8n – Eingang und Steuerung"><bpmn:flowNodeRef>s_start</bpmn:flowNodeRef><bpmn:flowNodeRef>g_rech</bpmn:flowNodeRef><bpmn:flowNodeRef>e_keine</bpmn:flowNodeRef><bpmn:flowNodeRef>g_dopp</bpmn:flowNodeRef><bpmn:flowNodeRef>e_skip</bpmn:flowNodeRef><bpmn:flowNodeRef>g_mode</bpmn:flowNodeRef><bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef><bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_pd" name="Prüfdienst – Regeln, Daten, Protokoll"><bpmn:flowNodeRef>t_lesen</bpmn:flowNodeRef><bpmn:flowNodeRef>t_lief</bpmn:flowNodeRef><bpmn:flowNodeRef>t_best</bpmn:flowNodeRef><bpmn:flowNodeRef>t_form</bpmn:flowNodeRef><bpmn:flowNodeRef>t_regel</bpmn:flowNodeRef><bpmn:flowNodeRef>g_mb</bpmn:flowNodeRef><bpmn:flowNodeRef>t_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>t_prot</bpmn:flowNodeRef><bpmn:flowNodeRef>e_done</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ag" name="Rechnungs-Agent (SRW)"><bpmn:flowNodeRef>t_agent</bpmn:flowNodeRef><bpmn:flowNodeRef>b_timer</bpmn:flowNodeRef><bpmn:flowNodeRef>g_ma</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s_start" name="Rechnungsmail eingegangen"><bpmn:outgoing>Flow_s_start_g_rech</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s_start" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="g_rech" name="Rechnung im Anhang?"><bpmn:incoming>Flow_s_start_g_rech</bpmn:incoming><bpmn:outgoing>Flow_g_rech_e_keine</bpmn:outgoing><bpmn:outgoing>Flow_g_rech_g_dopp</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e_keine" name="Kein Rechnungsvorgang"><bpmn:incoming>Flow_g_rech_e_keine</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="g_dopp" name="Bereits verarbeitet?"><bpmn:incoming>Flow_g_rech_g_dopp</bpmn:incoming><bpmn:outgoing>Flow_g_dopp_e_skip</bpmn:outgoing><bpmn:outgoing>Flow_g_dopp_t_lesen</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e_skip" name="Übersprungen"><bpmn:incoming>Flow_g_dopp_e_skip</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="t_lesen" name="Beleg lesen (XRechnung, ZUGFeRD, PDF, OCR)"><bpmn:incoming>Flow_g_dopp_t_lesen</bpmn:incoming><bpmn:outgoing>Flow_t_lesen_t_lief</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_lief" name="Lieferant, Register und Bankdaten prüfen"><bpmn:incoming>Flow_t_lesen_t_lief</bpmn:incoming><bpmn:outgoing>Flow_t_lief_t_best</bpmn:outgoing><bpmn:property id="Prop_t_lief_ds_data" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_ds_data_t_lief"><bpmn:sourceRef>ds_data</bpmn:sourceRef><bpmn:targetRef>Prop_t_lief_ds_data</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t_best" name="Bestellung, Preis und Wareneingang abgleichen"><bpmn:incoming>Flow_t_lief_t_best</bpmn:incoming><bpmn:outgoing>Flow_t_best_t_form</bpmn:outgoing><bpmn:property id="Prop_t_best_ds_data" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_ds_data_t_best"><bpmn:sourceRef>ds_data</bpmn:sourceRef><bpmn:targetRef>Prop_t_best_ds_data</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t_form" name="Formales, Dubletten, Skonto, Freigabeweg"><bpmn:incoming>Flow_t_best_t_form</bpmn:incoming><bpmn:outgoing>Flow_t_form_t_regel</bpmn:outgoing><bpmn:property id="Prop_t_form_ds_cfg" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_ds_cfg_t_form"><bpmn:sourceRef>ds_cfg</bpmn:sourceRef><bpmn:targetRef>Prop_t_form_ds_cfg</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t_regel" name="Regelvorschlag bilden"><bpmn:incoming>Flow_t_form_t_regel</bpmn:incoming><bpmn:outgoing>Flow_t_regel_g_mode</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_mode" name="Agent aktiv?"><bpmn:incoming>Flow_t_regel_g_mode</bpmn:incoming><bpmn:outgoing>Flow_g_mode_t_agent</bpmn:outgoing><bpmn:outgoing>Flow_g_mode_g_mb</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_agent" name="Befunde abwägen und begründen"><bpmn:incoming>Flow_g_mode_t_agent</bpmn:incoming><bpmn:outgoing>Flow_t_agent_g_ma</bpmn:outgoing></bpmn:task>
<bpmn:boundaryEvent id="b_timer" name="Zeitlimit (Rückfall: Regelvorschlag)" attachedToRef="t_agent"><bpmn:outgoing>Flow_b_timer_g_ma</bpmn:outgoing><bpmn:timerEventDefinition id="TED_b_timer"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="g_ma" name=""><bpmn:incoming>Flow_t_agent_g_ma</bpmn:incoming><bpmn:incoming>Flow_b_timer_g_ma</bpmn:incoming><bpmn:outgoing>Flow_g_ma_g_mb</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g_mb" name=""><bpmn:incoming>Flow_g_mode_g_mb</bpmn:incoming><bpmn:incoming>Flow_g_ma_g_mb</bpmn:incoming><bpmn:outgoing>Flow_g_mb_t_valid</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_valid" name="Vorschlag validieren (Leitplanken) und speichern"><bpmn:incoming>Flow_g_mb_t_valid</bpmn:incoming><bpmn:outgoing>Flow_t_valid_t_mail</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="t_mail" name="Vorschlagsmail senden"><bpmn:incoming>Flow_t_valid_t_mail</bpmn:incoming><bpmn:outgoing>Flow_t_mail_t_recv</bpmn:outgoing></bpmn:sendTask>
<bpmn:receiveTask id="t_recv" name="Entscheidung empfangen (signierter Link)"><bpmn:incoming>Flow_t_mail_t_recv</bpmn:incoming><bpmn:outgoing>Flow_t_recv_t_prot</bpmn:outgoing></bpmn:receiveTask>
<bpmn:serviceTask id="t_prot" name="Entscheidung protokollieren"><bpmn:incoming>Flow_t_recv_t_prot</bpmn:incoming><bpmn:outgoing>Flow_t_prot_e_done</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_t_prot_ds_log"><bpmn:targetRef>ds_log</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="e_done" name="Vorgang abgeschlossen"><bpmn:incoming>Flow_t_prot_e_done</bpmn:incoming></bpmn:endEvent>
<bpmn:dataStoreReference id="ds_data" name="Unternehmensdaten über Adapter (WAVE, ArchivPlus, Register, Banken)" />
<bpmn:dataStoreReference id="ds_cfg" name="Mandanten-Konfiguration (Grenzen, Toleranzen, Kontierung)" />
<bpmn:dataStoreReference id="ds_log" name="Prüfprotokoll (GoBD)" />
<bpmn:sequenceFlow id="Flow_s_start_g_rech" sourceRef="s_start" targetRef="g_rech" />
<bpmn:sequenceFlow id="Flow_g_rech_e_keine" name="nein" sourceRef="g_rech" targetRef="e_keine" />
<bpmn:sequenceFlow id="Flow_g_rech_g_dopp" name="ja" sourceRef="g_rech" targetRef="g_dopp" />
<bpmn:sequenceFlow id="Flow_g_dopp_e_skip" name="ja" sourceRef="g_dopp" targetRef="e_skip" />
<bpmn:sequenceFlow id="Flow_g_dopp_t_lesen" name="nein" sourceRef="g_dopp" targetRef="t_lesen" />
<bpmn:sequenceFlow id="Flow_t_lesen_t_lief" sourceRef="t_lesen" targetRef="t_lief" />
<bpmn:sequenceFlow id="Flow_t_lief_t_best" sourceRef="t_lief" targetRef="t_best" />
<bpmn:sequenceFlow id="Flow_t_best_t_form" sourceRef="t_best" targetRef="t_form" />
<bpmn:sequenceFlow id="Flow_t_form_t_regel" sourceRef="t_form" targetRef="t_regel" />
<bpmn:sequenceFlow id="Flow_t_regel_g_mode" sourceRef="t_regel" targetRef="g_mode" />
<bpmn:sequenceFlow id="Flow_g_mode_t_agent" name="ja" sourceRef="g_mode" targetRef="t_agent" />
<bpmn:sequenceFlow id="Flow_g_mode_g_mb" name="nein" sourceRef="g_mode" targetRef="g_mb" />
<bpmn:sequenceFlow id="Flow_t_agent_g_ma" sourceRef="t_agent" targetRef="g_ma" />
<bpmn:sequenceFlow id="Flow_b_timer_g_ma" sourceRef="b_timer" targetRef="g_ma" />
<bpmn:sequenceFlow id="Flow_g_ma_g_mb" sourceRef="g_ma" targetRef="g_mb" />
<bpmn:sequenceFlow id="Flow_g_mb_t_valid" sourceRef="g_mb" targetRef="t_valid" />
<bpmn:sequenceFlow id="Flow_t_valid_t_mail" sourceRef="t_valid" targetRef="t_mail" />
<bpmn:sequenceFlow id="Flow_t_mail_t_recv" sourceRef="t_mail" targetRef="t_recv" />
<bpmn:sequenceFlow id="Flow_t_recv_t_prot" sourceRef="t_recv" targetRef="t_prot" />
<bpmn:sequenceFlow id="Flow_t_prot_e_done" sourceRef="t_prot" targetRef="e_done" />
<bpmn:textAnnotation id="an_agent"><bpmn:text>Nur lesende Tools. Das LLM leitet keine Beträge oder Regeln ab; bei Lesefehlern Kennzeichnung statt stiller Korrektur</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="an_end"><bpmn:text>Keine automatische Zahlung, keine Änderung von Stammdaten</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_an_agent" sourceRef="t_agent" targetRef="an_agent" />
<bpmn:association id="Assoc_an_end" sourceRef="e_done" targetRef="an_end" />
</bpmn:process>
