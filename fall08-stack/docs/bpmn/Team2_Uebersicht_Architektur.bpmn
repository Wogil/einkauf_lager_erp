<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Team" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fall08-Generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Team" name="Team 2 – Gemeinsame Grundlage (Übersicht)">
<bpmn:participant id="P_Absender" name="Absender (Mail, Upload, Chat)" />
<bpmn:participant id="P_Weitere" name="Weitere Fachagenten (Angebot, Einkauf)" />
<bpmn:participant id="P_SB" name="Sachbearbeitung / Anfragende (erhält Ergebnis)" />
<bpmn:participant id="P_Orch" name="Plattform – Orchestrierung (generisch)" processRef="Process_P_Orch" />
<bpmn:participant id="P_Agent" name="Fachagent Rechnungsprüfung (Fall 08)" processRef="Process_P_Agent" />
<bpmn:messageFlow id="Msg_P_Absender_o_start" name="Vorgang" sourceRef="P_Absender" targetRef="o_start" />
<bpmn:messageFlow id="Msg_o_weitere_P_Weitere" name="Auftrag" sourceRef="o_weitere" targetRef="P_Weitere" />
<bpmn:messageFlow id="Msg_P_Weitere_o_recv" name="Ergebnis" sourceRef="P_Weitere" targetRef="o_recv" />
<bpmn:messageFlow id="Msg_o_rech_a_start" name="Auftrag" sourceRef="o_rech" targetRef="a_start" />
<bpmn:messageFlow id="Msg_a_end_o_recv" name="Vorschlag" sourceRef="a_end" targetRef="o_recv" />
<bpmn:messageFlow id="Msg_o_send_P_SB" name="Ergebnis / Vorschlag" sourceRef="o_send" targetRef="P_SB" />
</bpmn:collaboration>
<bpmn:process id="Process_P_Orch" isExecutable="false">
<bpmn:startEvent id="o_start" name="Geschäftsvorgang geht ein"><bpmn:outgoing>Flow_o_start_o_norm</bpmn:outgoing><bpmn:messageEventDefinition id="MED_o_start" /></bpmn:startEvent>
<bpmn:task id="o_norm" name="Eingang normalisieren (Kanal-Adapter)"><bpmn:incoming>Flow_o_start_o_norm</bpmn:incoming><bpmn:outgoing>Flow_o_norm_o_art</bpmn:outgoing></bpmn:task>
<bpmn:task id="o_art" name="Vorgangsart erkennen"><bpmn:incoming>Flow_o_norm_o_art</bpmn:incoming><bpmn:outgoing>Flow_o_art_o_gw</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="o_gw" name="Vorgangsart?"><bpmn:incoming>Flow_o_art_o_gw</bpmn:incoming><bpmn:outgoing>Flow_o_gw_o_weitere</bpmn:outgoing><bpmn:outgoing>Flow_o_gw_o_rech</bpmn:outgoing><bpmn:outgoing>Flow_o_gw_o_manuell</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="o_weitere" name="Fachagent Angebot / Einkauf beauftragen"><bpmn:incoming>Flow_o_gw_o_weitere</bpmn:incoming><bpmn:outgoing>Flow_o_weitere_o_m1</bpmn:outgoing></bpmn:sendTask>
<bpmn:sendTask id="o_rech" name="Rechnungs-Agent beauftragen"><bpmn:incoming>Flow_o_gw_o_rech</bpmn:incoming><bpmn:outgoing>Flow_o_rech_o_m1</bpmn:outgoing></bpmn:sendTask>
<bpmn:task id="o_manuell" name="Als manuell zu bearbeiten kennzeichnen"><bpmn:incoming>Flow_o_gw_o_manuell</bpmn:incoming><bpmn:outgoing>Flow_o_manuell_o_m3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="o_m1" name=""><bpmn:incoming>Flow_o_weitere_o_m1</bpmn:incoming><bpmn:incoming>Flow_o_rech_o_m1</bpmn:incoming><bpmn:outgoing>Flow_o_m1_o_recv</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:receiveTask id="o_recv" name="Ergebnis empfangen"><bpmn:incoming>Flow_o_m1_o_recv</bpmn:incoming><bpmn:outgoing>Flow_o_recv_o_m2</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="o_timer" name="Zeitlimit" attachedToRef="o_recv"><bpmn:outgoing>Flow_o_timer_o_fallback</bpmn:outgoing><bpmn:timerEventDefinition id="TED_o_timer"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:task id="o_fallback" name="Rückfallebene: Regelergebnis verwenden"><bpmn:incoming>Flow_o_timer_o_fallback</bpmn:incoming><bpmn:outgoing>Flow_o_fallback_o_m2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="o_m2" name=""><bpmn:incoming>Flow_o_recv_o_m2</bpmn:incoming><bpmn:incoming>Flow_o_fallback_o_m2</bpmn:incoming><bpmn:outgoing>Flow_o_m2_o_m3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="o_m3" name=""><bpmn:incoming>Flow_o_m2_o_m3</bpmn:incoming><bpmn:incoming>Flow_o_manuell_o_m3</bpmn:incoming><bpmn:outgoing>Flow_o_m3_o_send</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="o_send" name="Ergebnis zustellen"><bpmn:incoming>Flow_o_m3_o_send</bpmn:incoming><bpmn:outgoing>Flow_o_send_o_end</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="o_end" name="Vorgang übergeben"><bpmn:incoming>Flow_o_send_o_end</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_o_start_o_norm" sourceRef="o_start" targetRef="o_norm" />
<bpmn:sequenceFlow id="Flow_o_norm_o_art" sourceRef="o_norm" targetRef="o_art" />
<bpmn:sequenceFlow id="Flow_o_art_o_gw" sourceRef="o_art" targetRef="o_gw" />
<bpmn:sequenceFlow id="Flow_o_gw_o_weitere" name="Angebot / Einkauf" sourceRef="o_gw" targetRef="o_weitere" />
<bpmn:sequenceFlow id="Flow_o_gw_o_rech" name="Rechnung" sourceRef="o_gw" targetRef="o_rech" />
<bpmn:sequenceFlow id="Flow_o_gw_o_manuell" name="nicht zuordenbar" sourceRef="o_gw" targetRef="o_manuell" />
<bpmn:sequenceFlow id="Flow_o_weitere_o_m1" sourceRef="o_weitere" targetRef="o_m1" />
<bpmn:sequenceFlow id="Flow_o_rech_o_m1" sourceRef="o_rech" targetRef="o_m1" />
<bpmn:sequenceFlow id="Flow_o_m1_o_recv" sourceRef="o_m1" targetRef="o_recv" />
<bpmn:sequenceFlow id="Flow_o_recv_o_m2" sourceRef="o_recv" targetRef="o_m2" />
<bpmn:sequenceFlow id="Flow_o_timer_o_fallback" sourceRef="o_timer" targetRef="o_fallback" />
<bpmn:sequenceFlow id="Flow_o_fallback_o_m2" sourceRef="o_fallback" targetRef="o_m2" />
<bpmn:sequenceFlow id="Flow_o_m2_o_m3" sourceRef="o_m2" targetRef="o_m3" />
<bpmn:sequenceFlow id="Flow_o_manuell_o_m3" sourceRef="o_manuell" targetRef="o_m3" />
<bpmn:sequenceFlow id="Flow_o_m3_o_send" sourceRef="o_m3" targetRef="o_send" />
<bpmn:sequenceFlow id="Flow_o_send_o_end" sourceRef="o_send" targetRef="o_end" />
<bpmn:textAnnotation id="a_routing"><bpmn:text>Bei Mail-Eingang deterministisch (z. B. XRechnung-Anhang), LLM-Routing nur bei freien Chat-Anfragen</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_a_routing" sourceRef="o_art" targetRef="a_routing" />
</bpmn:process>
<bpmn:process id="Process_P_Agent" isExecutable="false">
<bpmn:startEvent id="a_start" name="Auftrag erhalten"><bpmn:outgoing>Flow_a_start_a_cfg</bpmn:outgoing><bpmn:messageEventDefinition id="MED_a_start" /></bpmn:startEvent>
<bpmn:task id="a_cfg" name="Mandanten-Konfiguration laden"><bpmn:incoming>Flow_a_start_a_cfg</bpmn:incoming><bpmn:outgoing>Flow_a_cfg_a_data</bpmn:outgoing><bpmn:property id="Prop_a_cfg_ds_cfg" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_ds_cfg_a_cfg"><bpmn:sourceRef>ds_cfg</bpmn:sourceRef><bpmn:targetRef>Prop_a_cfg_ds_cfg</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task>
<bpmn:task id="a_data" name="Daten über Adapter abrufen"><bpmn:incoming>Flow_a_cfg_a_data</bpmn:incoming><bpmn:outgoing>Flow_a_data_a_rules</bpmn:outgoing><bpmn:property id="Prop_a_data_ds_data" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_ds_data_a_data"><bpmn:sourceRef>ds_data</bpmn:sourceRef><bpmn:targetRef>Prop_a_data_ds_data</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task>
<bpmn:task id="a_rules" name="Regelprüfung (deterministisch)"><bpmn:incoming>Flow_a_data_a_rules</bpmn:incoming><bpmn:outgoing>Flow_a_rules_a_llm</bpmn:outgoing></bpmn:task>
<bpmn:task id="a_llm" name="Befunde abwägen und begründen (LLM)"><bpmn:incoming>Flow_a_rules_a_llm</bpmn:incoming><bpmn:outgoing>Flow_a_llm_a_val</bpmn:outgoing></bpmn:task>
<bpmn:task id="a_val" name="Vorschlag validieren (Leitplanken)"><bpmn:incoming>Flow_a_llm_a_val</bpmn:incoming><bpmn:outgoing>Flow_a_val_a_end</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="a_end" name="Vorschlag senden"><bpmn:incoming>Flow_a_val_a_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_a_end" /></bpmn:endEvent>
<bpmn:dataStoreReference id="ds_cfg" name="Mandanten-Konfiguration (Grenzen, Regeln, Kontierung)" />
<bpmn:dataStoreReference id="ds_data" name="Unternehmensdaten (ERP, CSV, Register …)" />
<bpmn:sequenceFlow id="Flow_a_start_a_cfg" sourceRef="a_start" targetRef="a_cfg" />
<bpmn:sequenceFlow id="Flow_a_cfg_a_data" sourceRef="a_cfg" targetRef="a_data" />
<bpmn:sequenceFlow id="Flow_a_data_a_rules" sourceRef="a_data" targetRef="a_rules" />
<bpmn:sequenceFlow id="Flow_a_rules_a_llm" sourceRef="a_rules" targetRef="a_llm" />
<bpmn:sequenceFlow id="Flow_a_llm_a_val" sourceRef="a_llm" targetRef="a_val" />
<bpmn:sequenceFlow id="Flow_a_val_a_end" sourceRef="a_val" targetRef="a_end" />
<bpmn:textAnnotation id="a_trenn"><bpmn:text>Generisch: Ablauf, Prüfschritte, Agent, Leitplanken. Mandantenspezifisch: nur Konfiguration und Daten-Adapter</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
