# Kopieren nach .env und Werte setzen. Die .env gehört NICHT ins Git.

# Pfad zum Szenario-Ordner (enthält companies/ und world/). Standard: Elternordner dieses Stacks.
FALL08_DATEN=..

# Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Prüfdienst: Token für n8n und SRW (MCP) – lang und zufällig wählen (z. B. openssl rand -hex 32)
PRUEFDIENST_TOKEN=bitte-aendern
PRUEFDIENST_PORT=8000
# Adresse, unter der der Prüfdienst von außen erreichbar ist (Belege in Mails; MCP für SRW)
PRUEFDIENST_PUBLIC_URL=http://localhost:8000
# Signatur der Entscheidungs-Links in den Mails
LINK_SECRET=bitte-aendern

# n8n
N8N_ENCRYPTION_KEY=bitte-aendern
# Adresse, unter der n8n von außen erreichbar ist (für Links in den Mails)
N8N_PUBLIC_URL=http://localhost:5678

# Prüfmodus:  regeln = nur feste Regeln (Baseline, ohne SRW)  |  srw = SRW-Agent entscheidet
PRUEFMODUS=regeln

# SRW (nur für PRUEFMODUS=srw)
SRW_API_URL=https://api.example-srw-instanz.de
SRW_API_KEY=ak_...
SRW_EXPERT=rechnungspruefer
SRW_PROJECT_ID=

# Absender der Ergebnis-Mails
MAIL_ABSENDER=rechnungspruefung@vosskamp-pumpen.example
